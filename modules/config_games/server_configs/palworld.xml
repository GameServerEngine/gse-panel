<game_config>
  <game_key>palworld</game_key>
  <installer>steamcmd</installer>
  <game_name>Palworld</game_name>
  <os>
    <windows arch="x64">
      <exe>PalServer.exe</exe>
      <cli_template>-publiclobby -useperfthreads -NoAsyncLoadingThread -UseMultithreadForDS -servername='%HOSTNAME%' -port='%PORT%' -queryport='%STEAMPORT%'</cli_template>
      <cli_params>
        <cli_param id="HOSTNAME" cli_string=""/>
        <cli_param id="PORT" cli_string=""/>
      </cli_params>
      <reserve_ports>
        <port type="add" id="STEAMPORT" cli_string="">18804</port>
      </reserve_ports>
    </windows>
    <linux arch="x64">
      <exe>PalServer-Linux-Shipping</exe>
      <exe_location>Pal/Binaries/Linux</exe_location>
      <cli_template>-publiclobby -useperfthreads -NoAsyncLoadingThread -UseMultithreadForDS -servername='%HOSTNAME%' -port='%PORT%' -queryport='%STEAMPORT%'</cli_template>
      <cli_params>
        <cli_param id="HOSTNAME" cli_string=""/>
        <cli_param id="PORT" cli_string=""/>
      </cli_params>
      <reserve_ports>
        <port type="add" id="STEAMPORT" cli_string="">18804</port>
      </reserve_ports>
      <post_install><![CDATA[
# steamclient.so for the Steam API (LinuxGSM fix_steamcmd.sh does the same).
for bits in 64 32; do
  lib="$(find . "$HOME/.steam" "$HOME/.local/share/Steam" -maxdepth 4 -path "*linux$bits/steamclient.so" 2> /dev/null | head -n 1)"
  if [ -z "$lib" ]; then lib="$(find "$HOME" -maxdepth 5 -path "*steamcmd/linux$bits/steamclient.so" 2> /dev/null | head -n 1)"; fi
  if [ -n "$lib" ]; then
    mkdir -p "$HOME/.steam/sdk$bits"
    ln -sf "$(readlink -f "$lib")" "$HOME/.steam/sdk$bits/steamclient.so"
  fi
done
]]></post_install>
      <configuration_files>
        <file description="Server config">Pal/Saved/Config/LinuxServer/PalWorldSettings.ini</file>
      </configuration_files>
    </linux>
  </os>
  <mods>
