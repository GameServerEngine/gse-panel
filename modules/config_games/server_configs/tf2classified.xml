<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by tools/lgsm_xml/generate.py from LinuxGSM tf2cserver (lgsm/config-default/config-lgsm/tf2cserver/_default.cfg). -->
<!-- Note: The Windows block uses Steam's Windows executable with the same start options; not yet tested on a GSE agent. -->
<!-- Note: Uses Team Fortress 2 server files from the tf2 folder (-tf_path). If the server reports missing TF2 content, install Steam app 232250 into tf2/. -->
<game_config>
  <game_key>tf2classified</game_key>
  <protocol>lgsl</protocol>
  <lgsl_query_name>source</lgsl_query_name>
  <installer>steamcmd</installer>
  <game_name>Team Fortress 2 Classified</game_name>
  <os>
    <windows arch="x64">
      <exe>srcds_win64.exe</exe>
      <cli_template>-game tf2classified -tf_path %HOME_PATH%/tf2 -strictportbind -ip %IP% -port %PORT% +clientport %CLIENTPORT% +tv_port %SOURCETVPORT% +map %MAP% %GSLT% +servercfgfile server.cfg -maxplayers %PLAYERS%</cli_template>
      <cli_params>
        <cli_param id="HOME_PATH" cli_string=""/>
        <cli_param id="IP" cli_string=""/>
        <cli_param id="PORT" cli_string=""/>
        <cli_param id="MAP" cli_string=""/>
        <cli_param id="PLAYERS" cli_string=""/>
      </cli_params>
      <reserve_ports>
        <port type="add" id="CLIENTPORT" cli_string="">10</port>
        <port type="add" id="SOURCETVPORT" cli_string="">5</port>
      </reserve_ports>
      <maps_location>tf2classified/maps/</maps_location>
      <server_params>
        <param id="GSLT" key="+sv_setsteamaccount" type="text">
          <default/>
          <caption>Steam Game Server Login Token</caption>
          <options>s</options>
        </param>
      </server_params>
    </windows>
    <linux arch="x64">
      <exe>srcds.sh</exe>
      <cli_template>-game tf2classified -tf_path %HOME_PATH%/tf2 -strictportbind -ip %IP% -port %PORT% +clientport %CLIENTPORT% +tv_port %SOURCETVPORT% +map %MAP% %GSLT% +servercfgfile server.cfg -maxplayers %PLAYERS%</cli_template>
      <cli_params>
        <cli_param id="HOME_PATH" cli_string=""/>
        <cli_param id="IP" cli_string=""/>
        <cli_param id="PORT" cli_string=""/>
        <cli_param id="MAP" cli_string=""/>
        <cli_param id="PLAYERS" cli_string=""/>
      </cli_params>
      <reserve_ports>
        <port type="add" id="CLIENTPORT" cli_string="">10</port>
        <port type="add" id="SOURCETVPORT" cli_string="">5</port>
      </reserve_ports>
      <maps_location>tf2classified/maps/</maps_location>
      <server_params>
        <param id="GSLT" key="+sv_setsteamaccount" type="text">
          <default/>
          <caption>Steam Game Server Login Token</caption>
          <options>s</options>
        </param>
      </server_params>
      <post_install><![CDATA[
# steamclient.so for the Steam API (LinuxGSM fix_steamcmd.sh does the same).
for bits in 64 32; do
  lib="$(find . "$HOME/.steam" "$HOME/.local/share/Steam" -maxdepth 4 -path "*linux$bits/steamclient.so" 2> /dev/null | head -n 1)"
  if [ -z "$lib" ]; then lib="$(find "$HOME" -maxdepth 5 -path "*steamcmd/linux$bits/steamclient.so" 2> /dev/null | head -n 1)"; fi
  if [ -n "$lib" ]; then
    mkdir -p "$HOME/.steam/sdk$bits"
    ln -sf "$(readlink -f "$lib")" "$HOME/.steam/sdk$bits/steamclient.so"
  fi
done
]]></post_install>
      <configuration_files>
        <file description="Server config">tf2classified/cfg/server.cfg</file>
      </configuration_files>
    </linux>
  </os>
  <max_user_amount>16</max_user_amount>
  <mods>
    <mod key="default">
      <name>Default</name>
      <installer_name>3557020</installer_name>
      <installer_login>anonymous</installer_login>
    </mod>
  </mods>
</game_config>
