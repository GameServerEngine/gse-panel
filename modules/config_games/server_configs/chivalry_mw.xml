      </cli_params>
      <reserve_ports>
        <port type="add" id="QUERYPORT" cli_string="">2</port>
      </reserve_ports>
    </windows>
    <linux arch="x64">
      <exe>UDKGameServer-Linux</exe>
      <exe_location>Binaries/Linux</exe_location>
      <cli_template>AOCTD-Frigid_p?steamsockets -multihome=%IP% -Port=%PORT% -QueryPort=%QUERYPORT% -seekfreeloadingserver -configsubdir=gse -log=%HOME_PATH%/Saved/Logs/gse-game.log</cli_template>
      <cli_params>
        <cli_param id="IP" cli_string=""/>
        <cli_param id="PORT" cli_string=""/>
        <cli_param id="HOME_PATH" cli_string=""/>
      </cli_params>
      <reserve_ports>
        <port type="add" id="QUERYPORT" cli_string="">2</port>
      </reserve_ports>
      <post_install><![CDATA[
# Folders the server writes its log into.
mkdir -p Saved/Logs

# steamclient.so for the Steam API (LinuxGSM fix_steamcmd.sh does the same).
for bits in 64 32; do
  lib="$(find . "$HOME/.steam" "$HOME/.local/share/Steam" -maxdepth 4 -path "*linux$bits/steamclient.so" 2> /dev/null | head -n 1)"
  if [ -z "$lib" ]; then lib="$(find "$HOME" -maxdepth 5 -path "*steamcmd/linux$bits/steamclient.so" 2> /dev/null | head -n 1)"; fi
  if [ -n "$lib" ]; then
    mkdir -p "$HOME/.steam/sdk$bits"
    ln -sf "$(readlink -f "$lib")" "$HOME/.steam/sdk$bits/steamclient.so"
  fi
done
mkdir -p "Binaries/Linux/lib" && cp -f "$HOME/.steam/sdk32/steamclient.so" "Binaries/Linux/lib/steamclient.so" 2> /dev/null || true

echo 219640 > Binaries/Linux/steam_appid.txt
]]></post_install>
      <configuration_files>
