  <installer>steamcmd</installer>
  <game_name>Chivalry: Medieval Warfare</game_name>
  <os>
    <windows arch="x64">
      <exe>UDK.exe</exe>
      <exe_location>Binaries/Win32</exe_location>
      <cli_template>AOCTD-Frigid_p?steamsockets -multihome=%IP% -Port=%PORT% -QueryPort=%QUERYPORT% -seekfreeloadingserver -configsubdir=gse -log=%HOME_PATH%/Saved/Logs/gse-game.log</cli_template>
