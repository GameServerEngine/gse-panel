<?xml version='1.0' encoding='utf-8'?>
<game_config>
  <!-- Linux block generated by tools/lgsm_xml from LinuxGSM ceserver. -->
  <game_key>conanexiles</game_key>
  <protocol>lgsl</protocol>
  <lgsl_query_name>conanexiles</lgsl_query_name>
  <installer>steamcmd</installer>
  <game_name>Conan Exiles</game_name>
  <os>
    <windows arch="x64">
      <exe>ConanSandboxServer.exe</exe>
      <cli_template>%PORT% %QUERY_PORT% %PLAYERS% -log</cli_template>
      <cli_params>
        <cli_param id="IP" cli_string="-MULTIHOME=" />
        <cli_param id="PORT" cli_string="-Port=" />
        <cli_param id="PLAYERS" cli_string="-MaxPlayers=" />
      </cli_params>
      <reserve_ports>
        <port type="add" id="QUERY_PORT" cli_string="-QueryPort=">15</port>
      </reserve_ports>
      <console_log>ConanSandbox/Saved/Logs/ConanSandbox.log</console_log>
      <replace_texts>
        <text key="home_name">
          <default>ServerName=.*</default>
          <var>ServerName=</var>
          <filepath>ConanSandbox/Config/DefaultEngine.ini</filepath>
        </text>
        <text key="control_password">
          <default>AdminPassword=.*</default>
          <var>AdminPassword=</var>
          <filepath>ConanSandbox/Config/DefaultServerSettings.ini</filepath>
        </text>
      </replace_texts>
      <configuration_files>
        <file description="Engine.ini ">ConanSandbox\Config\DefaultEngine.ini</file>
        <file description="Game.ini ">ConanSandbox\Config\DefaultGame.ini</file>
        <file description="ServerSettings.ini">ConanSandbox\Config\DefaultServerSettings.ini</file>
      </configuration_files>
    </windows>
    <linux arch="x64">
      <exe>ConanSandboxServer-Linux-Shipping</exe>
      <exe_location>ConanSandbox/Binaries/Linux</exe_location>
      <cli_template>ConanSandbox -log -MULTIHOME=%IP% -Port=%PORT% -QueryPort=%QUERYPORT% -ServerName='%HOSTNAME%' -MaxPlayers=%PLAYERS%</cli_template>
      <cli_params>
        <cli_param id="IP" cli_string="" />
        <cli_param id="PORT" cli_string="" />
        <cli_param id="HOSTNAME" cli_string="" />
        <cli_param id="PLAYERS" cli_string="" />
      </cli_params>
      <reserve_ports>
        <port type="add" id="QUERYPORT" cli_string="">15</port>
      </reserve_ports>
      <post_install>
# steamclient.so for the Steam API (LinuxGSM fix_steamcmd.sh does the same).
for bits in 64 32; do
  lib="$(find . "$HOME/.steam" "$HOME/.local/share/Steam" -maxdepth 4 -path "*linux$bits/steamclient.so" 2&gt; /dev/null | head -n 1)"
  if [ -z "$lib" ]; then lib="$(find "$HOME" -maxdepth 5 -path "*steamcmd/linux$bits/steamclient.so" 2&gt; /dev/null | head -n 1)"; fi
  if [ -n "$lib" ]; then
    mkdir -p "$HOME/.steam/sdk$bits"
    ln -sf "$(readlink -f "$lib")" "$HOME/.steam/sdk$bits/steamclient.so"
  fi
done
</post_install>
      <configuration_files>
        <file description="Server config">ConanSandbox/Saved/Config/LinuxServer/ServerSettings.ini</file>
      </configuration_files>
    </linux>
  </os>
  <max_user_amount>70</max_user_amount>
  <mods>
    <mod key="default">
      <name>None</name>
      <installer_name>443030</installer_name>
      <installer_login>anonymous</installer_login>
    </mod>
  </mods>
</game_config>