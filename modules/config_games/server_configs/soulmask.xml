<game_config>
  <game_key>soulmask</game_key>
  <installer>steamcmd</installer>
  <game_name>Soulmask</game_name>
  <os>
    <linux arch="x64">
      <exe>WSServer-Linux-Shipping</exe>
      <exe_location>WS/Binaries/Linux</exe_location>
      <cli_template>WS Level01_Main -MultiHome=%IP% -Port=%PORT% -EchoPort=%TELNETPORT% -QueryPort=%QUERYPORT% -SteamServerName='%HOSTNAME%' -PSW='' -adminpsw='%CONTROL_PASSWORD%' -MaxPlayers=%PLAYERS% -initbackup %BACKUPINTERVAL% -UTF8Output -forcepassthrough -log</cli_template>
      <cli_params>
        <cli_param id="IP" cli_string=""/>
        <cli_param id="PORT" cli_string=""/>
        <cli_param id="HOSTNAME" cli_string=""/>
        <cli_param id="CONTROL_PASSWORD" cli_string=""/>
        <cli_param id="PLAYERS" cli_string=""/>
      </cli_params>
      <reserve_ports>
        <port type="add" id="TELNETPORT" cli_string="">10111</port>
        <port type="add" id="QUERYPORT" cli_string="">18238</port>
      </reserve_ports>
      <server_params>
        <param id="BACKUPINTERVAL" key="-backupinterval=" type="text">
          <default>15</default>
          <caption>Backup interval (minutes)</caption>
          <desc>Backup interval in minutes.</desc>
          <options>ns</options>
        </param>
      </server_params>
      <post_install><![CDATA[
# steamclient.so for the Steam API (LinuxGSM fix_steamcmd.sh does the same).
for bits in 64 32; do
  lib="$(find . "$HOME/.steam" "$HOME/.local/share/Steam" -maxdepth 4 -path "*linux$bits/steamclient.so" 2> /dev/null | head -n 1)"
  if [ -z "$lib" ]; then lib="$(find "$HOME" -maxdepth 5 -path "*steamcmd/linux$bits/steamclient.so" 2> /dev/null | head -n 1)"; fi
  if [ -n "$lib" ]; then
    mkdir -p "$HOME/.steam/sdk$bits"
    ln -sf "$(readlink -f "$lib")" "$HOME/.steam/sdk$bits/steamclient.so"
  fi
done
]]></post_install>
      <environment_variables>
export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:{GAME_HOME_DIR}:{GAME_HOME_DIR}/linux64
      </environment_variables>
    </linux>
  </os>
  <max_user_amount>50</max_user_amount>
  <mods>
    <mod key="default">
