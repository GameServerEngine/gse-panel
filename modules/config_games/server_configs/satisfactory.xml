<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by tools/lgsm_xml/generate.py from LinuxGSM sfserver (lgsm/config-default/config-lgsm/sfserver/_default.cfg). -->
<!-- Note: The Windows block uses Steam's Windows executable with the same start options; not yet tested on a GSE agent. -->
<game_config>
  <game_key>satisfactory</game_key>
  <installer>steamcmd</installer>
  <game_name>Satisfactory</game_name>
  <os>
    <windows arch="x64">
      <exe>FactoryServer.exe</exe>
      <cli_template>FactoryGame -Port=%PORT% -ReliablePort=%RELIABLEPORT% -log</cli_template>
      <cli_params>
        <cli_param id="PORT" cli_string=""/>
      </cli_params>
      <reserve_ports>
        <port type="add" id="RELIABLEPORT" cli_string="">1111</port>
      </reserve_ports>
    </windows>
    <linux arch="x64">
      <exe>FactoryServer-Linux-Shipping</exe>
      <exe_location>Engine/Binaries/Linux</exe_location>
      <cli_template>FactoryGame -Port=%PORT% -ReliablePort=%RELIABLEPORT% -log</cli_template>
      <cli_params>
        <cli_param id="PORT" cli_string=""/>
      </cli_params>
      <reserve_ports>
        <port type="add" id="RELIABLEPORT" cli_string="">1111</port>
      </reserve_ports>
      <post_install><![CDATA[
# steamclient.so for the Steam API (LinuxGSM fix_steamcmd.sh does the same).
for bits in 64 32; do
  lib="$(find . "$HOME/.steam" "$HOME/.local/share/Steam" -maxdepth 4 -path "*linux$bits/steamclient.so" 2> /dev/null | head -n 1)"
  if [ -z "$lib" ]; then lib="$(find "$HOME" -maxdepth 5 -path "*steamcmd/linux$bits/steamclient.so" 2> /dev/null | head -n 1)"; fi
  if [ -n "$lib" ]; then
    mkdir -p "$HOME/.steam/sdk$bits"
    ln -sf "$(readlink -f "$lib")" "$HOME/.steam/sdk$bits/steamclient.so"
  fi
done
]]></post_install>
      <configuration_files>
        <file description="Server config">FactoryGame/Saved/Config/LinuxServer/GameUserSettings.ini</file>
      </configuration_files>
    </linux>
  </os>
  <mods>
    <mod key="default">
      <name>Default</name>
      <installer_name>1690800</installer_name>
      <installer_login>anonymous</installer_login>
    </mod>
  </mods>
</game_config>
