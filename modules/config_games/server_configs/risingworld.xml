<!-- Generated by tools/lgsm_xml/generate.py from LinuxGSM rwserver (lgsm/config-default/config-lgsm/rwserver/_default.cfg). -->
<!-- Note: The Windows block uses Steam's Windows executable with the same start options; not yet tested on a GSE agent. -->
<!-- Note: LinuxGSM starts this server without a port option; the port is read from server.properties. Set it there to the port the panel assigned. -->
<game_config>
  <game_key>risingworld</game_key>
  <installer>steamcmd</installer>
  <game_name>Rising World</game_name>
  <os>
    <windows arch="x64">
      <exe>RisingWorldServer.exe</exe>
    </windows>
    <linux arch="x64">
      <exe>RisingWorldServer.x64</exe>
      <post_install><![CDATA[
# steamclient.so for the Steam API (LinuxGSM fix_steamcmd.sh does the same).
for bits in 64 32; do
  lib="$(find . "$HOME/.steam" "$HOME/.local/share/Steam" -maxdepth 4 -path "*linux$bits/steamclient.so" 2> /dev/null | head -n 1)"
  if [ -z "$lib" ]; then lib="$(find "$HOME" -maxdepth 5 -path "*steamcmd/linux$bits/steamclient.so" 2> /dev/null | head -n 1)"; fi
  if [ -n "$lib" ]; then
    mkdir -p "$HOME/.steam/sdk$bits"
    ln -sf "$(readlink -f "$lib")" "$HOME/.steam/sdk$bits/steamclient.so"
  fi
done
]]></post_install>
      <environment_variables>
export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:{GAME_HOME_DIR}:{GAME_HOME_DIR}/linux64
      </environment_variables>
      <configuration_files>
        <file description="Server config">server.properties</file>
      </configuration_files>
    </linux>
  </os>
  <mods>
    <mod key="default">
      <name>Default</name>
      <installer_name>339010</installer_name>
      <installer_login>anonymous</installer_login>
      <betaname>unity</betaname>
    </mod>
  </mods>
</game_config>
