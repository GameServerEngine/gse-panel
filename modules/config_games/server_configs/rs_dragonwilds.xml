    <linux arch="x64">
      <exe>RSDragonwildsServer-Linux-Shipping</exe>
      <exe_location>RSDragonwilds/Binaries/Linux</exe_location>
      <cli_template>-Port=%PORT% -log</cli_template>
      <cli_params>
        <cli_param id="PORT" cli_string=""/>
