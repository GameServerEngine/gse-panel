  <installer>steamcmd</installer>
  <game_name>Base Defense</game_name>
  <os>
    <linux arch="x64">
      <exe>hlds_run</exe>
      <cli_template>-game bdef -strictportbind +ip %IP% -port %PORT% +clientport %CLIENTPORT% +map %MAP% +servercfgfile server.cfg -maxplayers %PLAYERS%</cli_template>
      <cli_params>
        <cli_param id="IP" cli_string=""/>
