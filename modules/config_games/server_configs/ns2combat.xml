        <cli_param id="IP" cli_string=""/>
        <cli_param id="CONTROL_PASSWORD" cli_string=""/>
        <cli_param id="PLAYERS" cli_string=""/>
        <cli_param id="HOME_PATH" cli_string=""/>
      </cli_params>
      <reserve_ports>
        <port type="subtract" id="HTTPPORT" cli_string="">18935</port>
      </reserve_ports>
      <server_params>
        <param id="HTTPUSER" key="-webuser" type="text">
          <default>admin</default>
          <caption>Web admin user name</caption>
          <options>s</options>
        </param>
      </server_params>
    </windows>
    <linux arch="x64">
      <exe>ns2combatserver_linux32</exe>
      <exe_location>ia32</exe_location>
      <cli_template>-name '%HOSTNAME%' -port %PORT% -webadmin -webdomain %IP% %HTTPUSER% -webpassword '%CONTROL_PASSWORD%' -webport %HTTPPORT% -map co_core -limit %PLAYERS% -config_path '%HOME_PATH%/gse' -modstorage '%HOME_PATH%/gse/Workshop' -mods ''</cli_template>
      <cli_params>
        <cli_param id="HOSTNAME" cli_string=""/>
        <cli_param id="PORT" cli_string=""/>
        <cli_param id="IP" cli_string=""/>
        <cli_param id="CONTROL_PASSWORD" cli_string=""/>
        <cli_param id="PLAYERS" cli_string=""/>
        <cli_param id="HOME_PATH" cli_string=""/>
      </cli_params>
      <reserve_ports>
        <port type="subtract" id="HTTPPORT" cli_string="">18935</port>
      </reserve_ports>
      <server_params>
        <param id="HTTPUSER" key="-webuser" type="text">
          <default>admin</default>
          <caption>Web admin user name</caption>
          <options>s</options>
        </param>
      </server_params>
      <post_install><![CDATA[
# steamclient.so for the Steam API (LinuxGSM fix_steamcmd.sh does the same).
for bits in 64 32; do
  lib="$(find . "$HOME/.steam" "$HOME/.local/share/Steam" -maxdepth 4 -path "*linux$bits/steamclient.so" 2> /dev/null | head -n 1)"
  if [ -z "$lib" ]; then lib="$(find "$HOME" -maxdepth 5 -path "*steamcmd/linux$bits/steamclient.so" 2> /dev/null | head -n 1)"; fi
  if [ -n "$lib" ]; then
    mkdir -p "$HOME/.steam/sdk$bits"
    ln -sf "$(readlink -f "$lib")" "$HOME/.steam/sdk$bits/steamclient.so"
  fi
done
]]></post_install>
    </linux>
  </os>
  <max_user_amount>24</max_user_amount>
  <mods>
    <mod key="default">
      <name>Default</name>
      <installer_name>313900</installer_name>
      <installer_login>anonymous</installer_login>
    </mod>
  </mods>
</game_config>
