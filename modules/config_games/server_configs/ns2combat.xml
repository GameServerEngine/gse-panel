<!-- Note: The Windows block uses Steam's Windows executable with the same start options; not yet tested on a GSE agent. -->
<game_config>
  <game_key>ns2combat</game_key>
  <installer>steamcmd</installer>
  <game_name>NS2: Combat</game_name>
  <os>
    <windows arch="x64">
      <exe>ns2combatserver.exe</exe>
      <cli_template>-name '%HOSTNAME%' -port %PORT% -webadmin -webdomain %IP% %HTTPUSER% -webpassword '%CONTROL_PASSWORD%' -webport %HTTPPORT% -map co_core -limit %PLAYERS% -config_path '%HOME_PATH%/gse' -modstorage '%HOME_PATH%/gse/Workshop' -mods ''</cli_template>
      <cli_params>
        <cli_param id="HOSTNAME" cli_string=""/>
