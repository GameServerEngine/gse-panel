<!-- Note: The Windows block uses Steam's Windows executable with the same start options; not yet tested on a GSE agent. -->
<!-- Note: LinuxGSM starts this server without a port option; the port is read from Config/ServerConfig.txt. Set it there to the port the panel assigned. -->
<game_config>
  <game_key>survivethenights</game_key>
  <installer>steamcmd</installer>
  <game_name>Survive the Nights</game_name>
  <os>
    <windows arch="x64">
      <exe>STN_Dedicated_Server.exe</exe>
      <cli_template>-mc %PLAYERS% %REGION%</cli_template>
      <cli_params>
        <cli_param id="PLAYERS" cli_string=""/>
      </cli_params>
      <server_params>
        <param id="REGION" key="-r" type="text">
          <default>0</default>
          <caption>Server region</caption>
          <options>s</options>
        </param>
      </server_params>
    </windows>
    <linux arch="x64">
      <exe>Server_Linux_x64</exe>
      <cli_template>-mc %PLAYERS% %REGION%</cli_template>
      <cli_params>
        <cli_param id="PLAYERS" cli_string=""/>
      </cli_params>
      <server_params>
        <param id="REGION" key="-r" type="text">
          <default>0</default>
          <caption>Server region</caption>
          <options>s</options>
        </param>
      </server_params>
      <post_install><![CDATA[
# steamclient.so for the Steam API (LinuxGSM fix_steamcmd.sh does the same).
for bits in 64 32; do
  lib="$(find . "$HOME/.steam" "$HOME/.local/share/Steam" -maxdepth 4 -path "*linux$bits/steamclient.so" 2> /dev/null | head -n 1)"
  if [ -z "$lib" ]; then lib="$(find "$HOME" -maxdepth 5 -path "*steamcmd/linux$bits/steamclient.so" 2> /dev/null | head -n 1)"; fi
  if [ -n "$lib" ]; then
    mkdir -p "$HOME/.steam/sdk$bits"
    ln -sf "$(readlink -f "$lib")" "$HOME/.steam/sdk$bits/steamclient.so"
  fi
done
]]></post_install>
      <configuration_files>
        <file description="Server config">Config/ServerConfig.txt</file>
      </configuration_files>
    </linux>
  </os>
  <max_user_amount>20</max_user_amount>
  <mods>
    <mod key="default">
      <name>Default</name>
      <installer_name>1502300</installer_name>
      <installer_login>anonymous</installer_login>
    </mod>
  </mods>
</game_config>
