      <cli_template>KidsBedroom?MaxPlayers=%PLAYERS% -ServerName='%HOSTNAME%' -Port=%PORT% -QueryPort=%QUERYPORT%</cli_template>
      <cli_params>
        <cli_param id="PLAYERS" cli_string=""/>
