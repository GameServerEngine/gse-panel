        </param>
        <param id="SAVEINTERVAL" key="-SaveWorldInterval=" type="text">
          <default>300</default>
          <caption>Save interval (seconds)</caption>
          <desc>Auto-save in seconds.</desc>
          <options>ns</options>
        </param>
        <param id="GREENHAND" key="-GreenHand=" type="text">
          <default>true</default>
          <caption>New player protection</caption>
          <options>ns</options>
        </param>
        <param id="ALLOWSENSITIVEWORDS" key="-SensitiveWords=" type="text">
          <default>true</default>
          <caption>Allow sensitive words in chat</caption>
          <options>ns</options>
        </param>
        <param id="ANTICHEAT" key="-UseEAC=" type="text">
          <default>true</default>
          <caption>Easy Anti-Cheat</caption>
          <options>ns</options>
        </param>
        <param id="ADMINLABEL" key="-IsShowGmTitle=" type="text">
          <default>true</default>
          <caption>Show admin title</caption>
          <desc>Enable admin icon.</desc>
          <options>ns</options>
        </param>
      </server_params>
      <post_install><![CDATA[
# steamclient.so for the Steam API (LinuxGSM fix_steamcmd.sh does the same).
for bits in 64 32; do
  lib="$(find . "$HOME/.steam" "$HOME/.local/share/Steam" -maxdepth 4 -path "*linux$bits/steamclient.so" 2> /dev/null | head -n 1)"
  if [ -z "$lib" ]; then lib="$(find "$HOME" -maxdepth 5 -path "*steamcmd/linux$bits/steamclient.so" 2> /dev/null | head -n 1)"; fi
  if [ -n "$lib" ]; then
    mkdir -p "$HOME/.steam/sdk$bits"
    ln -sf "$(readlink -f "$lib")" "$HOME/.steam/sdk$bits/steamclient.so"
  fi
done
]]></post_install>
    </linux>
  </os>
  <max_user_amount>40</max_user_amount>
  <mods>
    <mod key="default">
      <name>Default</name>
      <installer_name>2334200</installer_name>
      <installer_login>anonymous</installer_login>
    </mod>
  </mods>
