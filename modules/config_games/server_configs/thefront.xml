  <os>
    <linux arch="x64">
      <exe>TheFrontServer</exe>
      <exe_location>ProjectWar/Binaries/Linux</exe_location>
      <cli_template>ProjectWar_Start?DedicatedServer?MaxPlayers=%PLAYERS% -server -game -log -MultiHome=%IP% -Port=%PORT% -QueryPort=%QUERYPORT% -BeaconPort=%BEACONPORT% -ShutDownServicePort=%SHUTDOWNPORT% -ConfigServerName='gse' -OutIPAddress=%IP% -ServerTags='LinuxGSM' %STEAMSOCKET% -UserDir='%HOME_PATH%/gse' -ServerName='%HOSTNAME%' -EnableParallelCharacterMovementTickFunction -EnableParallelCharacterTickFunction -UseDynamicPhysicsScene -Game.PhysicsVehicle=false -ansimalloc -Game.MaxFrameRate=35 %MAXQUEUESIZE% %QUEUEVALIDTIME% -QueueThreshold=%PLAYERS% %GAMEMODE% %DAMAGESELF% %DAMAGEALLIES% %SAVEINTERVAL% -GMOverlapRatio=2 %GREENHAND% %ALLOWSENSITIVEWORDS% %ANTICHEAT% -ServerAdminAccounts='' %ADMINLABEL% -ServerPassword=''</cli_template>
      <cli_params>
        <cli_param id="PLAYERS" cli_string=""/>
        <cli_param id="IP" cli_string=""/>
        <cli_param id="PORT" cli_string=""/>
        <cli_param id="HOME_PATH" cli_string=""/>
        <cli_param id="HOSTNAME" cli_string=""/>
      </cli_params>
      <reserve_ports>
        <port type="add" id="QUERYPORT" cli_string="">15</port>
        <port type="add" id="BEACONPORT" cli_string="">1</port>
        <port type="add" id="SHUTDOWNPORT" cli_string="">2</port>
      </reserve_ports>
      <server_params>
        <param id="STEAMSOCKET" key="-UseSteamSocket=" type="text">
          <default>0</default>
          <caption>Use Steam sockets</caption>
          <desc>Use Steam Socket. 0 = off; 1 = on. Use Steam Servers for network penetration. Enable this if you don't have a public IP but you want to allow players from outside your network to join your server. If disabled, only you and other players on your LAN can join. If you have a public IP, you do not need to enable this.</desc>
          <options>ns</options>
        </param>
        <param id="MAXQUEUESIZE" key="-MaxQueueSize=" type="text">
          <default>50</default>
          <caption>Join queue size</caption>
          <options>ns</options>
        </param>
        <param id="QUEUEVALIDTIME" key="-QueueValidTime=" type="text">
          <default>120</default>
          <caption>Join queue hold time</caption>
          <options>ns</options>
        </param>
        <param id="GAMEMODE" key="-ServerFightModeType=" type="text">
          <default>0</default>
          <caption>Game mode</caption>
          <desc>0 = PvP; 1 = PvE</desc>
          <options>ns</options>
        </param>
        <param id="DAMAGESELF" key="-IsCanSelfDamage=" type="text">
          <default>true</default>
          <caption>Self damage</caption>
          <options>ns</options>
        </param>
        <param id="DAMAGEALLIES" key="-IsCanFriendDamage=" type="text">
