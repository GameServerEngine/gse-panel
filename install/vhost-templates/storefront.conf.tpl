# Apache vhost for the GSE Panel customer storefront (modules/billing) —
# generated by the installer. Modeled on the known-correct
# examples/apache/gameservers.world-billing-vhost.conf.
#
# Placeholders (replaced by includes/lib_vhosts.php / scripts/install-panel.sh --configure-vhosts):
#   {{SERVER_NAME}}      storefront domain / hostname
#   {{DOCUMENT_ROOT}}    absolute path to <panel install>/modules/billing
#   {{PANEL_ROOT}}       absolute path to the panel install (derived from DOCUMENT_ROOT)
#   {{ERROR_LOG_NAME}}   log file name stem (no spaces)
#   {{CERT_FULLCHAIN}}   absolute path to fullchain.pem (existing-cert / letsencrypt modes)
#   {{CERT_PRIVKEY}}     absolute path to privkey.pem (existing-cert / letsencrypt modes)
#
# If the storefront shares the panel's domain (no separate storefront domain
# configured), the installer does not generate this file at all — the
# storefront is served from a sub-path alias under the panel vhost instead
# (see the Alias block the installer adds to panel.conf in that case).

<VirtualHost *:80>
    ServerName {{SERVER_NAME}}

    DocumentRoot {{DOCUMENT_ROOT}}

    <Directory {{DOCUMENT_ROOT}}>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    # Shared panel files (images, themes) are served from the panel folder, at the same
    # /panel/... paths the storefront uses when it runs inside the panel.
    Alias /panel/images {{PANEL_ROOT}}/images
    Alias /panel/themes {{PANEL_ROOT}}/themes
    <Directory {{PANEL_ROOT}}/images>
        Options -Indexes
        Require all granted
    </Directory>
    <Directory {{PANEL_ROOT}}/themes>
        Options -Indexes
        Require all granted
    </Directory>

    ErrorLog ${APACHE_LOG_DIR}/{{ERROR_LOG_NAME}}_error.log
    CustomLog ${APACHE_LOG_DIR}/{{ERROR_LOG_NAME}}_access.log combined

    RewriteEngine on
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{SERVER_NAME}%{REQUEST_URI} [END,NE,R=permanent]
</VirtualHost>

<IfModule mod_ssl.c>
<VirtualHost *:443>
    ServerName {{SERVER_NAME}}

    DocumentRoot {{DOCUMENT_ROOT}}

    <Directory {{DOCUMENT_ROOT}}>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    # Shared panel files (images, themes) are served from the panel folder, at the same
    # /panel/... paths the storefront uses when it runs inside the panel.
    Alias /panel/images {{PANEL_ROOT}}/images
    Alias /panel/themes {{PANEL_ROOT}}/themes
    <Directory {{PANEL_ROOT}}/images>
        Options -Indexes
        Require all granted
    </Directory>
    <Directory {{PANEL_ROOT}}/themes>
        Options -Indexes
        Require all granted
    </Directory>

    ErrorLog ${APACHE_LOG_DIR}/{{ERROR_LOG_NAME}}_error.log
    CustomLog ${APACHE_LOG_DIR}/{{ERROR_LOG_NAME}}_access.log combined

    SSLEngine on
    SSLCertificateFile {{CERT_FULLCHAIN}}
    SSLCertificateKeyFile {{CERT_PRIVKEY}}
</VirtualHost>
</IfModule>
