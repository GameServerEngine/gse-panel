[Unit]
Description=restic REST server for GSE customer backups (private repos, one account per game home)
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
User=restic-rest
Group=restic-rest
ExecStart=/usr/local/bin/rest-server --path @DATA_DIR@ --listen @LISTEN@ --private-repos --htpasswd-file /etc/restic-rest/htpasswd
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=@DATA_DIR@
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
