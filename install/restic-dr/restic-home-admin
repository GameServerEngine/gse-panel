#!/bin/bash
# restic-home-admin: manages one game home's REST account on the backup server (DR).
# Called by the GSE panel over ssh:  sudo -n /usr/local/sbin/restic-home-admin set|purge home-<id>
# set:   reads one line "home-<id>:<bcrypt hash>" on stdin, replaces that user's htpasswd line, restarts restic-rest.
# purge: removes that user's htpasswd line, deletes the home's repo directory, restarts restic-rest.
# Installed by install-dr.sh, which replaces @DATA_DIR@ with the repo storage directory.
set -euo pipefail
HTPASSWD=/etc/restic-rest/htpasswd
DATA=@DATA_DIR@
SERVICE=restic-rest
action=${1:-}
user=${2:-}
[[ "$user" =~ ^home-[0-9]+$ ]] || { echo "bad user" >&2; exit 2; }
exec 9>/run/restic-home-admin.lock
flock 9
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
case "$action" in
  set)
    IFS= read -r line
    hash=${line#"$user:"}
    [[ "$line" == "$user:"* ]] || { echo "line does not match user" >&2; exit 2; }
    [[ "$hash" =~ ^\$2y\$[0-9]{2}\$[./A-Za-z0-9]{53}$ ]] || { echo "bad bcrypt hash" >&2; exit 2; }
    grep -v "^$user:" "$HTPASSWD" > "$tmp" || true
    printf '%s\n' "$line" >> "$tmp"
    install -m 640 -o root -g restic-rest "$tmp" "$HTPASSWD"
    ;;
  purge)
    grep -v "^$user:" "$HTPASSWD" > "$tmp" || true
    install -m 640 -o root -g restic-rest "$tmp" "$HTPASSWD"
    if [[ -d "$DATA/$user" ]]; then rm -rf -- "$DATA/$user"; fi
    ;;
  *) echo "usage: $0 set|purge home-<id>" >&2; exit 2 ;;
esac
systemctl restart "$SERVICE"
echo "ok $action $user"
